# gostty
#
# The Go package is generated from Zig sources, and the Go build links a native
# archive that Zig produces. Both live under zig/ and are driven from there.

ZIG     ?= zig
GO      ?= go
ZIG_DIR := zig
# The native archives and the C header are installed here, beside the Go
# package: they are what the Go build links, so they belong somewhere a Go
# developer would look rather than under zig-out.
LIB_DIR := libs
LINK_DIR := internal/raw

# The release matrix uses Zig target names. Override TARGETS to build a subset,
# for example: make generate TARGETS="aarch64-macos x86_64-linux-gnu"
TARGETS ?= aarch64-macos x86_64-macos aarch64-linux-gnu x86_64-linux-gnu aarch64-windows-gnu x86_64-windows-gnu

HOST_GOOS   := $(shell $(GO) env GOOS)
HOST_GOARCH := $(shell $(GO) env GOARCH)
HOST_ZIG_ARCH := $(if $(filter arm64,$(HOST_GOARCH)),aarch64,$(if $(filter amd64,$(HOST_GOARCH)),x86_64,unsupported))
HOST_ZIG_OS := $(if $(filter darwin,$(HOST_GOOS)),macos,$(if $(filter linux,$(HOST_GOOS)),linux-gnu,$(if $(filter windows,$(HOST_GOOS)),windows-gnu,unsupported)))
HOST_TARGET := $(HOST_ZIG_ARCH)-$(HOST_ZIG_OS)

# The native library dominates run time and Zig's default is Debug, which costs
# roughly 360x on VT parsing (feeding one line: 159us Debug, 5.8us ReleaseSafe,
# 0.44us ReleaseFast). ReleaseSafe keeps the bounds and overflow checks, which
# is what you want for code parsing whatever a program writes to a pty; trade
# them for the last of the speed with:
#
#   make build OPTIMIZE=ReleaseFast
OPTIMIZE ?= ReleaseSafe
# The install prefix is the repository root, so `libs/` lands beside the Go
# package. The generated cgo directives point at it, so it has to match.
ZIG_FLAGS := -Doptimize=$(OPTIMIZE) --prefix $(CURDIR)

.DEFAULT_GOAL := help
.PHONY: help all build generate generate-one test race bench vet example verify check doctor report fmt clean distclean

help: ## Show this help
	@grep -hE '^[a-z-]+:.*?## ' $(MAKEFILE_LIST) | \
		awk -F':.*?## ' '{printf "  \033[36m%-12s\033[0m %s\n", $$1, $$2}'

all: build test ## Build the native library and run the tests

build: ## Build and install the native binding library for this host
	$(MAKE) --no-print-directory generate-one \
		TARGET=$(HOST_TARGET) GOOS=$(HOST_GOOS) GOARCH=$(HOST_GOARCH)

# Through the generator rather than `go-lib`: a Debug build needs Zig's UBSan
# runtime on the cgo link line and the release modes must not have it, and that
# line is written when the bindings are generated. Generating is half a second
# once Zig's cache is warm, and it produces the same committed files every
# time, so paying it here is cheaper than a link that silently disagrees with
# the mode it was built in.
generate: ## Regenerate bindings and build native archives for TARGETS
	@set -eu; for target in $(TARGETS); do \
		case "$$target" in \
			aarch64-macos)       goos=darwin;  goarch=arm64 ;; \
			x86_64-macos)        goos=darwin;  goarch=amd64 ;; \
			aarch64-linux-gnu)    goos=linux;   goarch=arm64 ;; \
			x86_64-linux-gnu)     goos=linux;   goarch=amd64 ;; \
			aarch64-windows-gnu)  goos=windows; goarch=arm64 ;; \
			x86_64-windows-gnu)   goos=windows; goarch=amd64 ;; \
			*) echo "unsupported target: $$target" >&2; exit 2 ;; \
		esac; \
		$(MAKE) --no-print-directory generate-one \
			TARGET="$$target" GOOS="$$goos" GOARCH="$$goarch"; \
	done

# Build one target, preserve its generated link line under a platform build
# tag, and namespace every archive so all targets can coexist in libs/.
generate-one:
	@test -n "$(TARGET)" -a -n "$(GOOS)" -a -n "$(GOARCH)" || \
		{ echo "TARGET, GOOS and GOARCH are required" >&2; exit 2; }
	cd $(ZIG_DIR) && $(ZIG) build go $(ZIG_FLAGS) -Dtarget=$(TARGET)
	@sed 's|/libs/lib|/libs/$(TARGET)_lib|g' \
		$(LINK_DIR)/zigo_link_inputs_gen.go | \
		awk 'NR == 1 { print "// Code generated by make generate. DO NOT EDIT."; next } \
			NR == 3 { print "//go:build $(GOOS) && $(GOARCH)" } { print }' \
		> $(LINK_DIR)/zigo_link_inputs_$(GOOS)_$(GOARCH)_gen.go.tmp
	@mv $(LINK_DIR)/zigo_link_inputs_$(GOOS)_$(GOARCH)_gen.go.tmp \
		$(LINK_DIR)/zigo_link_inputs_$(GOOS)_$(GOARCH)_gen.go
	@rm -f $(LINK_DIR)/zigo_link_inputs_gen.go
	@for archive in $(LIB_DIR)/lib*.a; do \
		[ -e "$$archive" ] || continue; \
		base=$${archive##*/}; \
		mv "$$archive" "$(LIB_DIR)/$(TARGET)_$$base"; \
	done
	@touch $(LIB_DIR)/$(TARGET)_libgostty_zigo.a

# Some zigo inspection steps materialize an untagged link file and generic
# archives as working inputs. Keep their exit status, but remove those volatile
# files so they cannot be selected alongside the platform-tagged matrix.
define run-zig-tool
	@status=0; (cd $(ZIG_DIR) && $(ZIG) build $(1) $(ZIG_FLAGS)) || status=$$?; \
		rm -f $(LINK_DIR)/zigo_link_inputs_gen.go $(LIB_DIR)/lib*.a; \
		exit $$status
endef

test: build ## Run the Go tests
	$(GO) test ./...

race: build ## Run the Go tests under the race detector
	$(GO) test -race -count=2 ./...

bench: build ## Run the benchmarks
	$(GO) test -bench . -benchmem -run '^$$' ./...

vet: build ## Run go vet
	$(GO) vet ./...
	cd example && $(GO) vet ./...

example: build ## Run the example terminal emulator
	cd example && $(GO) run .

verify: ## Validate generated bindings, toolchain and native library
	$(call run-zig-tool,go-verify)

check: ## Fail if the committed Go bindings are stale
	$(call run-zig-tool,go-check)

doctor: ## Check the Go binding toolchain prerequisites
	$(call run-zig-tool,go-doctor)

coverage: ## Report which public Zig declarations are bound
	$(call run-zig-tool,go-coverage)

report: ## Explain the effective Go binding contract
	$(call run-zig-tool,go-report)

fmt: ## Format Zig and Go sources
	$(ZIG) fmt $(ZIG_DIR)/build.zig $(ZIG_DIR)/src
	$(GO) fmt ./...

clean: ## Remove build outputs
	rm -rf $(LIB_DIR) $(ZIG_DIR)/zig-out $(ZIG_DIR)/.zig-cache
	rm -f $(LINK_DIR)/zigo_link_inputs*_gen.go

distclean: clean ## Also remove fetched Zig packages
	rm -rf $(ZIG_DIR)/zig-pkg
